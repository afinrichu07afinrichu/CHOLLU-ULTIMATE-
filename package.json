{
  "name": "chollu",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create chollu-db",
    "db:migrate": "wrangler d1 migrations apply chollu-db --remote",
    "check": "node scripts/check.mjs",
    "test": "npm run check && npm run test:api",
    "test:api": "node --experimental-sqlite scripts/api-test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
