{
  "name": "chollu",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "chollu-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chollu-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}
